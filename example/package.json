{
  "name": "arcore-react-example",
  "version": "1.0.0",
  "description": "React/Vite example application for the ARCore React SDK",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "npm run cert && node scripts/show-ip.js && vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "cap sync",
    "open:android": "cap open android",
    "cert": "node scripts/generate-cert.js",
    "preinstall": "npm install --prefix .. --no-audit --no-fund"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "capacitor-arcore": "file:..",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.14"
  },
  "private": true
}
