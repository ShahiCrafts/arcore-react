# AR Playground Environment Configuration

# HTTPS Server Configuration
VITE_PORT=5173
VITE_HOST=0.0.0.0

# For local development, the server will be available at:
# - Local machine: https://localhost:5173
# - Network: https://YOUR_MACHINE_IP:5173

# Your development IP will be shown when running:
# npm run dev:https

# Note: Self-signed SSL certificates are included:
# - localhost-cert.pem
# - localhost-key.pem
# 
# These are for local development only.
# Your browser will show a certificate warning - this is expected.
# Click "Proceed" or "Accept" to continue.
